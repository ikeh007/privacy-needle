<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_editorial_hero"
                android:paddingStart="22dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="THE PRIVACY BRIEF"
                    android:textColor="@color/gold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.15"
                    android:textStyle="bold"
                    android:textSize="11sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Stay informed.&#10;Stay protected."
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="25sp"
                    android:lineSpacingExtra="2dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Privacy news, expert explainers and everyday digital safety."
                    android:textColor="@color/light_text"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topBannerWrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADVERTISEMENT"
                    android:textSize="10sp"
                    android:letterSpacing="0.12"
                    android:textColor="@color/text_secondary"/>

                <FrameLayout
                    android:id="@+id/topBannerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:foregroundGravity="center"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openScamChallenge"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:text="⚡  SCAM OF THE DAY  ·  PLAY NOW"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/ink"
                app:backgroundTint="@color/gold"
                app:cornerRadius="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openProductsButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="Explore AI, security tools and free games"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/ink"
                app:backgroundTint="@color/warm_gold"
                app:cornerRadius="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="7dp"
                android:text="Explore topics"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/ink"/>
        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/canvas"
            app:tabMode="scrollable"
            app:tabGravity="start"
            app:tabIndicatorColor="@color/gold"
            app:tabIndicatorHeight="3dp"
            app:tabIndicatorFullWidth="false"
            app:tabTextColor="@color/text_secondary"
            app:tabSelectedTextColor="@color/ink"
            app:tabRippleColor="@color/warm_gold"/>


</LinearLayout>
