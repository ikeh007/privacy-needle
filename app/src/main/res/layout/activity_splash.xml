<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_cinematic">

    <View
        android:layout_width="80dp"
        android:layout_height="3dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="52dp"
        android:layout_marginStart="28dp"
        android:background="@color/gold"
        android:alpha="0.85"/>

    <View
        android:layout_width="3dp"
        android:layout_height="66dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="54dp"
        android:layout_marginEnd="32dp"
        android:background="@color/gold"
        android:alpha="0.7"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="25dp"
        android:paddingEnd="25dp">

        <FrameLayout
            android:layout_width="305dp"
            android:layout_height="305dp"
            android:layout_gravity="center">

            <View
                android:id="@+id/splashRing"
                android:layout_width="292dp"
                android:layout_height="292dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_splash_ring"/>

            <View
                android:id="@+id/splashCore"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_splash_core"/>

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="184dp"
                android:layout_height="184dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/pneedle_bg"/>
        </FrameLayout>

        <TextView
            android:id="@+id/splashBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="PRIVACY NEEDLE"
            android:letterSpacing="0.16"
            android:gravity="center"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>

        <View
            android:id="@+id/splashLine"
            android:layout_width="84dp"
            android:layout_height="3dp"
            android:layout_marginTop="20dp"
            android:background="@color/gold"/>

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="NO LEAK. NO WAHALA ."
            android:letterSpacing="0.14"
            android:textColor="@color/gold"
            android:textSize="12sp"
            android:textStyle="bold"/>

    </LinearLayout>
</FrameLayout>
