<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/canvas">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/quiz_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white">

        <ImageView
            android:id="@+id/quiz_logo"
            android:layout_width="154dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:src="@drawable/privacyneedl"
            android:contentDescription="@string/app_name"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"/>
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_editorial_hero"
                android:padding="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TODAY'S CHALLENGE"
                    android:letterSpacing="0.13"
                    android:textColor="@color/gold"
                    android:textStyle="bold"
                    android:textSize="11sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Know your digital rights."
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="25sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Three quick questions, one smarter digital habit."
                    android:textColor="@color/light_text"
                    android:textSize="13sp"/>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="13dp">

                        <TextView
                            android:id="@+id/quizScoreCounter"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="0 correct"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/ink"/>

                        <TextView
                            android:id="@+id/quizStreakCounter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0-day streak"
                            android:background="@drawable/bg_gold_tag"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/gold_deep"/>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/quizProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:max="3"
                        android:progress="0"
                        android:progressTint="@color/gold"
                        android:progressBackgroundTint="@color/stroke"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:id="@+id/scoreText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Question 1 of 3"
                        android:textColor="@color/gold_deep"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/questionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="17dp"
                        android:text="Question"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/ink"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/opt1"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:layout_marginBottom="9dp"
                        android:text="Option 1"
                        android:textAllCaps="false"
                        android:textColor="@color/ink"
                        app:backgroundTint="@color/white"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/stroke"
                        app:strokeWidth="1dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/opt2"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:layout_marginBottom="9dp"
                        android:text="Option 2"
                        android:textAllCaps="false"
                        android:textColor="@color/ink"
                        app:backgroundTint="@color/white"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/stroke"
                        app:strokeWidth="1dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/opt3"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:layout_marginBottom="9dp"
                        android:text="Option 3"
                        android:textAllCaps="false"
                        android:textColor="@color/ink"
                        app:backgroundTint="@color/white"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/stroke"
                        app:strokeWidth="1dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/opt4"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:text="Option 4"
                        android:textAllCaps="false"
                        android:textColor="@color/ink"
                        app:backgroundTint="@color/white"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/stroke"
                        app:strokeWidth="1dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <FrameLayout
                android:id="@+id/quizResultNativeSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareQuizScore"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:text="Share my score  ·  Challenge friends"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/ink"
                android:visibility="gone"
                app:backgroundTint="@color/gold"
                app:cornerRadius="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuizSummary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:text="See today's quiz summary"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:visibility="gone"
                app:backgroundTint="@color/gold"
                app:cornerRadius="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBonusQuestion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:text="Watch an ad · Unlock 1 bonus question"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:contentDescription="Watch an optional rewarded advertisement to unlock one bonus quiz question"
                android:visibility="gone"
                app:backgroundTint="@color/gold"
                app:cornerRadius="14dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Small steps to stronger privacy habits."
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>

            <LinearLayout
                android:id="@+id/quizResultBannerWrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADVERTISEMENT"
                    android:textSize="10sp"
                    android:letterSpacing="0.12"
                    android:textColor="@color/text_secondary"/>

                <FrameLayout
                    android:id="@+id/quizResultBannerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:background="@color/ink"
        app:itemHorizontalTranslationEnabled="false"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="23dp"
        app:itemIconTint="@color/nav_tint"
        app:itemTextColor="@color/nav_tint"
        app:menu="@menu/bottom_post_details"/>
</LinearLayout>
